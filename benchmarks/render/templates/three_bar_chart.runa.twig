<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ this.width | int }} {{ this.height | int }}" width="{{ this.width | int }}" height="{{ this.height | int }}" role="img" aria-label="{{ this.title }}">
<style>
  .bg { fill: #0d1117; }
  .panel { fill: #161b22; stroke: #30363d; stroke-width: 1; }
  .grid { stroke: #21262d; stroke-width: 1; }
  .title { fill: #f0f6fc; font: 700 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .sub { fill: #8b949e; font: 400 12px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .lbl { fill: #c9d1d9; font: 500 11.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .tick { fill: #8b949e; font: 500 10.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .val { fill: #e6edf3; font: 600 10px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .spd { fill: #3fb950; font: 700 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .legend { fill: #c9d1d9; font: 500 11.5px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
</style>
<rect class="bg" width="{{ this.width | int }}" height="{{ this.height | int }}" rx="10"/>
<rect class="panel" x="{{ this.pad_l | int }}" y="{{ this.pad_t | int }}" width="{{ this.pw | int }}" height="{{ this.ph | int }}" rx="4"/>
<text class="title" x="24" y="30">{{ this.title }}</text>
<text class="sub" x="24" y="49">{{ this.subtitle }}</text>
<rect x="24" y="60" width="12" height="8" rx="2" fill="{{ this.odin_color }}"/>
<text class="legend" x="42" y="68">Odin (xitdb)</text>
<rect x="170" y="60" width="12" height="8" rx="2" fill="{{ this.lua_color }}"/>
<text class="legend" x="188" y="68">LuaJIT 2.1</text>
<rect x="306" y="60" width="12" height="8" rx="2" fill="{{ this.zig_color }}"/>
<text class="legend" x="324" y="68">Zig (reference)</text>
{%- for xt in this.x_ticks %}
<line class="grid" x1="{{ xt.pos }}" y1="{{ this.pad_t | int }}" x2="{{ xt.pos }}" y2="{{ this.plot_bottom | int }}"/>
<text class="tick" x="{{ xt.pos }}" y="{{ this.x_label_y | int }}" text-anchor="middle">{{ xt.label }}</text>
{%- end %}
{%- for grp in this.groups %}
<text class="lbl" x="{{ this.label_x | int }}" y="{{ grp.label_y }}" text-anchor="end">{{ grp.label }}</text>
<rect x="{{ this.pad_l | int }}" y="{{ grp.odin_y }}" width="{{ grp.odin_w }}" height="10" rx="2.5" fill="{{ this.odin_color }}"/>
<text class="val" x="{{ grp.odin_val_x }}" y="{{ grp.odin_text_y }}">{{ grp.odin_val }}</text>
<rect x="{{ this.pad_l | int }}" y="{{ grp.lua_y }}" width="{{ grp.lua_w }}" height="10" rx="2.5" fill="{{ this.lua_color }}"/>
<text class="val" x="{{ grp.lua_val_x }}" y="{{ grp.lua_text_y }}">{{ grp.lua_val }}</text>
<rect x="{{ this.pad_l | int }}" y="{{ grp.zig_y }}" width="{{ grp.zig_w }}" height="10" rx="2.5" fill="{{ this.zig_color }}"/>
<text class="val" x="{{ grp.zig_val_x }}" y="{{ grp.zig_text_y }}">{{ grp.zig_val }}</text>
<text class="spd" x="{{ this.badge_x | int }}" y="{{ grp.badge_y }}" text-anchor="end">{{ grp.speedup }}</text>
{%- end %}
</svg>
